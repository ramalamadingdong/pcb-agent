# Transient build/export output — ROOT-ANCHORED and per-board only.
# (A bare "build/" here once matched scripts/build/ and silently kept the
# entire pass port out of git; the commit claiming to land it was empty.)
/build/
/fab/
examples/*/fab/
examples/*/build/
examples/*/*.kicad_prl
examples/*/*-backups/

# Fetched tools (make setup re-fetches, checksum-verified)
tools/*.jar

# Residue from the flattened export this repo was restored from
mnt/

__pycache__/
*.pyc
.venv/

# pcbnew writes a .kicad_pro beside any board it saves; the snapshot has
# no use for one (route.py copies only the .kicad_pcb).
*/pre_route.kicad_pro
**/pre_route.kicad_pro

# What KiCad drops beside a project it opens. A reviewer opening a release
# makes these; verify_release ignores them and so does git.
**/release/**/*.kicad_prl
**/release/**/*-backups/
**/release/**/fp-info-cache
**/release/**/*.lck
# check_parity's DRC sample reports, if a run is killed mid-sample
.parity.*.json
